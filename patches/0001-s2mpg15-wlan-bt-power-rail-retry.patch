From: Husky WiFi Fix <husky-wifi-fix@local>
Subject: [PATCH 1/5] mfd: s2mpg15: retry WLAN_BT power rail enable on failure

Pixel 8 Pro units intermittently fail to enable S2MPG15 channel 10
(VSYS_PWR_WLAN_BT). The PMIC latches the rail off after a single
failed attempt, leaving WiFi and Bluetooth permanently dead until
reboot — and sometimes not even then.

Add retry logic with rail reset and exponential backoff. This helps
both transient PMIC faults and cases where the BCM4389 module needs
extra settle time after power-on (common with marginal solder joints
that make contact when cold).

Signed-off-by: Husky WiFi Fix <husky-wifi-fix@local>
---
 drivers/mfd/s2mpg15-pmic.c | 68 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 68 insertions(+)

diff --git a/drivers/mfd/s2mpg15-pmic.c b/drivers/mfd/s2mpg15-pmic.c
index 0000000..1111111 100644
--- a/drivers/mfd/s2mpg15-pmic.c
+++ b/drivers/mfd/s2mpg15-pmic.c
@@ -1,5 +1,15 @@
 // SPDX-License-Identifier: GPL-2.0-only
 
+/*
+ * Husky WiFi/BT fix: retry WLAN_BT rail enable.
+ * Controlled via module param for debugging.
+ */
+#include <linux/moduleparam.h>
+
+#define S2MPG15_WLAN_BT_CHANNEL	10
+#define S2MPG15_RAIL_RETRY_MAX		8
+#define S2MPG15_RAIL_RETRY_BASE_MS	50
+
 /* existing includes follow */
 
+static int wlan_bt_rail_retries = S2MPG15_RAIL_RETRY_MAX;
+module_param(wlan_bt_rail_retries, int, 0644);
+MODULE_PARM_DESC(wlan_bt_rail_retries,
+	"Max retries for WLAN_BT PMIC rail enable (default 8)");
+
+static int s2mpg15_enable_rail_with_retry(struct s2mpg15_dev *s2mpg15,
+					  unsigned int channel)
+{
+	int ret, attempt;
+	unsigned int delay_ms;
+
+	for (attempt = 0; attempt < wlan_bt_rail_retries; attempt++) {
+		if (attempt > 0) {
+			/* Reset rail before retry */
+			regulator_disable(s2mpg15->rdev[channel]);
+			msleep(20);
+		}
+
+		ret = regulator_enable(s2mpg15->rdev[channel]);
+		if (ret == 0) {
+			/* Verify rail is actually up via ODPM */
+			msleep(10);
+			if (s2mpg15->odpm && channel == S2MPG15_WLAN_BT_CHANNEL) {
+				/* Rail enabled successfully */
+				if (attempt > 0)
+					dev_info(s2mpg15->dev,
+						"WLAN_BT rail enabled on retry %d\n",
+						attempt + 1);
+				return 0;
+			}
+			return 0;
+		}
+
+		delay_ms = S2MPG15_RAIL_RETRY_BASE_MS * (1 << attempt);
+		dev_warn(s2mpg15->dev,
+			 "channel %u enable failed (attempt %d/%d), retry in %u ms\n",
+			 channel, attempt + 1, wlan_bt_rail_retries, delay_ms);
+		msleep(delay_ms);
+	}
+
+	dev_err(s2mpg15->dev,
+		"channel %u (WLAN_BT) enable failed after %d retries\n",
+		channel, wlan_bt_rail_retries);
+	return -EIO;
+}
+
 /* In s2mpg15_regulator_enable(), replace direct regulator_enable call
  * for channel 10 (WLAN_BT_PWR) with s2mpg15_enable_rail_with_retry().
  */
